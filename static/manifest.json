{
  "manifest_version": 3,
  "name": "PDF 2in1印刷",
  "version": "0.3.0",
  "description": "PDFの2ページを1枚に配置。右から左・左から右の順序を選んで印刷できます。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "PDF 2in1印刷",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": [
    "https://pos.toshin.com/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pos.toshin.com/*"
      ],
      "js": [
        "src/toshin-content-core.js",
        "src/toshin-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
